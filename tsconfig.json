{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "ponder.config.ts",
    "ponder.schema.ts",
    "ponder-env.d.ts"
  ],
  "exclude": ["node_modules", "apps/web", "testnet/fixtures/lib", "verification/solidity"]
}
