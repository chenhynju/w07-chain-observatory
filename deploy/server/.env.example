# Server-side indexer environment. Copy to the repository root as .env.
# Never commit the real .env.

POSTGRES_PASSWORD=replace_with_a_long_random_hex_string
DATABASE_SCHEMA=w07

# Initial public dashboard source: recent Ethereum mainnet USDC/WETH data.
# Replace with the Base Sepolia fixture after that deployment exists.
W07_CHAIN=ethereum
RPC_URL=https://ethereum-rpc.publicnode.com
PAIR_ADDRESS=0xB4e16d0168e52d35CaCD2c6185b44281Ec28C9Dc
START_BLOCK=26350904
# PAIR_CREATION_BLOCK is intentionally unset: coverage is partial.

RATE_LIMIT_PER_MINUTE=120
REQUEST_TIMEOUT_MS=5000
