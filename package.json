{
  "name": "w07-chain-observatory",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ponder dev",
    "start": "ponder start",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-functions=85 --test-coverage-branches=75 test/*.test.ts",
    "smoke": "bash scripts/smoke-anvil.sh",
    "smoke:postgres": "bash scripts/smoke-postgres.sh",
    "fixture:build": "cd testnet/fixtures && forge build",
    "fixture:test": "cd testnet/fixtures && forge test",
    "dev:demo": "bash scripts/dev-demo.sh",
    "stop:demo": "bash scripts/stop-demo.sh",
    "deploy:testnet": "bash scripts/deploy-testnet.sh",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:check": "npm --prefix apps/web run check"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "hono": "4.13.16",
    "ponder": "0.18.4",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "ponder": {
      "@hono/node-server": "2.1.6",
      "drizzle-orm": "0.45.4",
      "glob": "14.0.3",
      "graphql-yoga": "6.0.1",
      "vite": "8.3.6"
    }
  }
}
